{
  "expo": {
    "name": "allin",
    "slug": "superapp_che",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/allin-icon.png",
    "scheme": "superappche",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/allin-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.magamb0.superapp_che"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/allin-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/allin-wordmark.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter_18pt-Regular.ttf",
            "./assets/fonts/Inter_18pt-Bold.ttf",
            "./assets/fonts/Inter_18pt-SemiBold.ttf",
            "./assets/fonts/Roboto-Regular.ttf",
            "./assets/fonts/Roboto-Medium.ttf",
            "./assets/fonts/Roboto-Bold.ttf",
            "./assets/fonts/Ubuntu-Light.ttf",
            "./assets/fonts/Ubuntu-Regular.ttf",
            "./assets/fonts/Ubuntu-Medium.ttf",
            "./assets/fonts/Ubuntu-Bold.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec9e8e23-6ff5-49eb-8998-32bb3146d56c"
      }
    }
  }
}
